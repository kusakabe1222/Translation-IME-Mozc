# Translation IME settings app: API keys, engine, target languages and the
# on/off switch, stored in HKCU\Software\TranslationIME and read by the TIP
# (win32/tip/translation). Opened from the language bar menu (翻訳の設定).

load(
    "//:build_defs.bzl",
    "MOZC_TAGS",
    "mozc_win32_cc_prod_binary",
    "mozc_win32_resource_from_template",
)

package(default_visibility = ["//visibility:private"])

mozc_win32_cc_prod_binary(
    name = "mozc_translation_settings",
    srcs = [
        "translation_settings_main.cc",
        "translation_settings_resource.h",
    ],
    executable_name_map = {
        "Mozc": "mozc_translation_settings.exe",
        "GoogleJapaneseInput": "GoogleIMEJaTranslationSettings.exe",
    },
    linkopts = ["/SUBSYSTEM:WINDOWS"],
    static_crt = False,
    tags = MOZC_TAGS.WIN_ONLY,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//win32/installer:__subpackages__"],
    deps = [
        ":translation_settings_resource",
        "//bazel/win32:gdi32",
        "//bazel/win32:user32",
        "//win32/tip/translation",
    ],
)

mozc_win32_resource_from_template(
    name = "translation_settings_resource",
    src = "translation_settings.rc",
    manifests = [
        "mozc_translation_settings.exe.manifest",
    ],
    resources = [
        "translation_settings_resource.h",
        "//data/images/win:product_icon.ico",
    ],
    tags = MOZC_TAGS.WIN_ONLY,
    target_compatible_with = ["@platforms//os:windows"],
)
